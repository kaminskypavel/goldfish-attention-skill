#!/bin/sh
# Bump the patch version in both plugin manifests on every commit.
#
# The version is a cache key, not a semver contract: Claude Code caches an
# installed plugin under .../<name>/<version>/. Ship changed content under an
# unchanged version and every existing install keeps serving the old copy.
# Nothing pins a range here, so bumping always is cheaper than remembering to.
set -eu

MANIFESTS=".claude-plugin/plugin.json .codex-plugin/plugin.json"

# Skip when the commit does not touch the plugin at all (e.g. a hook edit only).
git diff --cached --quiet -- . ':(exclude).githooks' && exit 0

new=$(python3 - "$MANIFESTS" <<'PY'
import json, pathlib, sys
paths = [pathlib.Path(p) for p in sys.argv[1].split()]
vers = {json.loads(p.read_text())["version"] for p in paths}
if len(vers) != 1:
    sys.exit(f"pre-commit: manifests disagree on version: {sorted(vers)}")
major, minor, patch = (int(x) for x in vers.pop().split("."))
new = f"{major}.{minor}.{patch + 1}"
for p in paths:                       # rewrite in place, preserving formatting
    p.write_text(p.read_text().replace(f'"version": "{major}.{minor}.{patch}"',
                                       f'"version": "{new}"', 1))
print(new)
PY
)

git add $MANIFESTS
echo "pre-commit: version bumped to $new"
