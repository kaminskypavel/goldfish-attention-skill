{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/goldfish-activate.sh\" 2>/dev/null || exit 0",
            "commandWindows": "powershell -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\goldfish-activate.ps1\"",
            "timeout": 5,
            "statusMessage": "Loading goldfish mode..."
          }
        ]
      }
    ]
  }
}
